<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- USE_EXACT_ALARM statt SCHEDULE_EXACT_ALARM: wird bei Installation sofort gewaehrt
         (kein manueller Schritt in den Systemeinstellungen) und ist laut Play-Store-Richtlinie
         ausdruecklich fuer Alarm- und Medikamentenerinnerungs-Apps vorgesehen. Die Einschraenkung
         auf den Play Store gilt hier nicht, da die App nur als APK verteilt wird. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Fuer den System-Dialog "Akkuoptimierung ignorieren": seit Android 14 laesst sich die
         Ausnahme auf vielen Geraeten in den Einstellungen nicht mehr direkt setzen. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".DayOrganizerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.DayOrganizer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DayOrganizer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".platform.alarm.ErinnerungsEmpfaenger"
            android:exported="false">
            <intent-filter>
                <action android:name="de.vanhake.dayorganizer.ERINNERUNG_FAELLIG" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".platform.notification.AktionsEmpfaenger"
            android:exported="false">
            <intent-filter>
                <action android:name="de.vanhake.dayorganizer.ERLEDIGT" />
                <action android:name="de.vanhake.dayorganizer.SPAETER" />
                <action android:name="de.vanhake.dayorganizer.AUSGELASSEN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".platform.alarm.BootEmpfaenger"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.HeuteWidgetEmpfaenger"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heute_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetWeckerEmpfaenger"
            android:exported="false">
            <intent-filter>
                <action android:name="de.vanhake.dayorganizer.WIDGET_TAKT" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
